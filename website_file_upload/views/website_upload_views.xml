<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_website_upload_tree" model="ir.ui.view">
        <field name="name">website.upload.tree</field>
        <field name="model">website.upload</field>
        <field name="arch" type="xml">
            <tree string="Uploads">
                <field name="name"/>
                <field name="filename"/>
                <field name="mimetype"/>
                <field name="file_size"/>
                <field name="create_date"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_website_upload_form" model="ir.ui.view">
        <field name="name">website.upload.form</field>
        <field name="model">website.upload</field>
        <field name="arch" type="xml">
            <form string="Upload">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="filename" readonly="1"/>
                        <field name="mimetype" readonly="1"/>
                        <field name="file_size" readonly="1"/>
                        <field name="data" filename="filename"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_website_upload" model="ir.actions.act_window">
        <field name="name">Uploads do Website</field>
        <field name="res_model">website.upload</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_website_upload_root" name="Uploads" parent="website.menu_website_configuration" sequence="50"/>
    <menuitem id="menu_website_upload" name="Uploads" parent="menu_website_upload_root" action="action_website_upload"/>
</odoo>
